# Copy to .env.local (development) or set in your hosting environment.

# REQUIRED in production: random string, at least 32 characters.
# Signs the admin session cookie.  e.g.  openssl rand -base64 48
AUTH_SECRET=

# First owner account, created on first start when the database is empty.
# Without ADMIN_PASSWORD: development uses "admin12345", production generates
# a random password and prints it once in the server log.
ADMIN_EMAIL=admin@webspeed.local
ADMIN_PASSWORD=

# Where the SQLite database, uploaded media and payment receipts are stored.
# Must be a persistent, writable directory. Default: ./data
DATA_DIR=./data

# Public URL of the storefront (used for absolute Open Graph URLs).
SITE_URL=http://localhost:3000

# Store shown for hosts that do not match a store's custom domain.
# Default: the first store created.
# DEFAULT_STORE_SLUG=default

# Only for local testing of a production build over plain http.
# INSECURE_COOKIES=1
