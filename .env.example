# Copy to .env.local (development) or set in your hosting environment.
# The frontend has no database: all data comes from the Django API
# (repository webspeed-eshop-api).

# Server-side base URL of the Django API (used by server components, the
# middleware token refresh and the /api/v1 proxy rewrite). Must include /api/v1.
API_INTERNAL_URL=http://localhost:8000/api/v1

# Browser-side base URL. Keep the default "/api/v1" so requests go through
# this app's origin (proxied to API_INTERNAL_URL) and the httpOnly auth
# cookies stay first-party. Only change it if you serve the API on the same
# site and configure CORS/cookies accordingly.
NEXT_PUBLIC_API_URL=/api/v1

# Public URL of the storefront (absolute Open Graph URLs).
SITE_URL=http://localhost:3000

# Public media hosts allowed in next/image (MinIO / S3 / CDN), comma-separated.
# Must match S3_PUBLIC_URL of the API.
MEDIA_PUBLIC_URLS=http://localhost:9000/webspeed-media
