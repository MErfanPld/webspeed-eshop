# Environment variables for Vercel (Project → Settings → Environment Variables → Import .env)
# Set them for "Production" BEFORE deploying: API_INTERNAL_URL and MEDIA_PUBLIC_URLS are
# compiled into the build (proxy rewrites, next/image). Redeploy after changing them.
# API on PythonAnywhere: see deploy/PYTHONANYWHERE.md in the webspeed-eshop-api repository.

# Django API (must include /api/v1)
API_INTERNAL_URL=https://webspeedapi.pythonanywhere.com/api/v1

# Browser requests go through this app's own origin (keeps the login cookies first-party)
NEXT_PUBLIC_API_URL=/api/v1

# This site's public address: your Vercel URL, or https://your-domain once connected
SITE_URL=https://YOUR-APP.vercel.app

# Uploaded images (local storage on PythonAnywhere, served from /media/)
MEDIA_PUBLIC_URLS=https://webspeedapi.pythonanywhere.com/media

# Stores on subdomains: leave EMPTY on a *.vercel.app address (one store; landing at /platform).
# With your own domain + wildcard on Vercel, set e.g. webspeed.ir here AND in the API.
PLATFORM_DOMAIN=
PANEL_SUBDOMAIN=panel
TRIAL_DAYS=14
