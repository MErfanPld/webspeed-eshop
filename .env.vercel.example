# Environment variables for Vercel (Project → Settings → Environment Variables → Import .env)
# Replace webspeed.ir with your domain. Set them for "Production" BEFORE the first build:
# API_INTERNAL_URL and MEDIA_PUBLIC_URLS are compiled into the build (proxy rewrites, next/image).

# Public HTTPS address of the Django API (Vercel is not on your server, so the API
# must be reachable from the internet; "api" is a reserved subdomain, never a store)
API_INTERNAL_URL=https://api.webspeed.ir/api/v1

# Browser requests go through this app's own origin (keeps the login cookies first-party)
NEXT_PUBLIC_API_URL=/api/v1

# Landing site address (absolute Open Graph URLs, sitemap)
SITE_URL=https://webspeed.ir

# Public media bucket (product images); must equal S3_PUBLIC_URL of the API
MEDIA_PUBLIC_URLS=https://media.webspeed.ir/webspeed-media

# Multi-tenant platform: must equal the API's PLATFORM_DOMAIN
PLATFORM_DOMAIN=webspeed.ir
PANEL_SUBDOMAIN=panel
TRIAL_DAYS=14
